{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebu1ld.org/schemas/neurocad-vericodegen-task-v1.json",
  "title": "NeuroCAD VeriCodeGen benchmark task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt_id",
    "prompt_text",
    "task_family",
    "required_relations",
    "hard_constraints",
    "semantic_rubric"
  ],
  "properties": {
    "prompt_id": {
      "type": "string",
      "pattern": "^VCG-[0-9]{3}$"
    },
    "prompt_text": {
      "type": "string",
      "minLength": 1
    },
    "task_family": {
      "type": "string",
      "enum": ["in_distribution", "compositional", "ood_constraint_stress"]
    },
    "required_relations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "hard_constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "watertight": {"type": "boolean"},
        "max_components": {"type": "integer", "minimum": 1},
        "volume": {"$ref": "#/$defs/range"},
        "extents": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {"$ref": "#/$defs/range"},
            "y": {"$ref": "#/$defs/range"},
            "z": {"$ref": "#/$defs/range"}
          }
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {"$ref": "#/$defs/vector3"},
            "max": {"$ref": "#/$defs/vector3"}
          }
        }
      }
    },
    "semantic_rubric": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "description"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "min": {"type": "number"},
        "max": {"type": "number"}
      }
    },
    "vector3": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    }
  }
}
