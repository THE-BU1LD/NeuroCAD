{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebu1ld.org/schemas/neurocad-ir-v1.json",
  "title": "NeuroCAD canonical CAD program",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "units", "title", "nodes", "roots", "constraints", "metadata"],
  "properties": {
    "version": {"const": "neurocad-ir-v1"},
    "units": {"const": "mm"},
    "title": {"type": "string", "minLength": 1, "maxLength": 4096},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/node"}
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "constraints": {
      "type": "array",
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/constraint"}
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$", "minLength": 1, "maxLength": 128},
    "number": {"type": "number"},
    "positive": {"type": "number", "exclusiveMinimum": 0},
    "nonnegative": {"type": "number", "minimum": 0},
    "vector3": {
      "type": "array",
      "prefixItems": [{"$ref": "#/$defs/number"}, {"$ref": "#/$defs/number"}, {"$ref": "#/$defs/number"}],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "positiveVector3": {
      "type": "array",
      "prefixItems": [{"$ref": "#/$defs/positive"}, {"$ref": "#/$defs/positive"}, {"$ref": "#/$defs/positive"}],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translate", "rotate", "scale"],
      "properties": {
        "translate": {"$ref": "#/$defs/vector3"},
        "rotate": {"$ref": "#/$defs/vector3"},
        "scale": {"$ref": "#/$defs/vector3"}
      }
    },
    "primitive": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "parameters"],
          "properties": {"kind": {"const": "box"}, "parameters": {"type": "object", "additionalProperties": false, "required": ["size"], "properties": {"size": {"$ref": "#/$defs/positiveVector3"}}}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "parameters"],
          "properties": {"kind": {"const": "rounded_box"}, "parameters": {"type": "object", "additionalProperties": false, "required": ["size", "radius"], "properties": {"size": {"$ref": "#/$defs/positiveVector3"}, "radius": {"$ref": "#/$defs/nonnegative"}}}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "parameters"],
          "properties": {"kind": {"const": "sphere"}, "parameters": {"type": "object", "additionalProperties": false, "required": ["radius"], "properties": {"radius": {"$ref": "#/$defs/positive"}}}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "parameters"],
          "properties": {"kind": {"const": "cylinder"}, "parameters": {"type": "object", "additionalProperties": false, "required": ["radius", "height"], "properties": {"radius": {"$ref": "#/$defs/positive"}, "height": {"$ref": "#/$defs/positive"}}}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "parameters"],
          "properties": {"kind": {"const": "cone"}, "parameters": {"type": "object", "additionalProperties": false, "required": ["r1", "r2", "height"], "properties": {"r1": {"$ref": "#/$defs/nonnegative"}, "r2": {"$ref": "#/$defs/nonnegative"}, "height": {"$ref": "#/$defs/positive"}}}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "parameters"],
          "properties": {"kind": {"const": "torus"}, "parameters": {"type": "object", "additionalProperties": false, "required": ["major_radius", "minor_radius"], "properties": {"major_radius": {"$ref": "#/$defs/positive"}, "minor_radius": {"$ref": "#/$defs/positive"}}}}
        }
      ]
    },
    "node": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "primitive", "transform", "role"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "primitive": {"$ref": "#/$defs/primitive"}, "transform": {"$ref": "#/$defs/transform"}, "role": {"type": "string", "minLength": 1, "maxLength": 256}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "composition", "children", "transform", "role"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "composition": {"enum": ["union", "difference", "intersection"]}, "children": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "transform": {"$ref": "#/$defs/transform"}, "role": {"type": "string", "minLength": 1, "maxLength": 256}}
        }
      ]
    },
    "constraint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target", "parameters", "tolerance"],
          "properties": {
            "kind": {"const": "dimension"},
            "target": {"$ref": "#/$defs/id"},
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["parameter", "value"],
              "properties": {
                "parameter": {"type": "string", "minLength": 1, "maxLength": 128},
                "value": {"oneOf": [{"$ref": "#/$defs/number"}, {"$ref": "#/$defs/vector3"}]}
              }
            },
            "tolerance": {"$ref": "#/$defs/nonnegative"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target", "reference", "parameters", "tolerance"],
          "properties": {
            "kind": {"const": "coincident"},
            "target": {"$ref": "#/$defs/id"},
            "reference": {"$ref": "#/$defs/id"},
            "parameters": {"type": "object", "additionalProperties": false, "maxProperties": 0},
            "tolerance": {"$ref": "#/$defs/nonnegative"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target", "reference", "parameters", "tolerance"],
          "properties": {
            "kind": {"const": "offset"},
            "target": {"$ref": "#/$defs/id"},
            "reference": {"$ref": "#/$defs/id"},
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["vector"],
              "properties": {"vector": {"$ref": "#/$defs/vector3"}}
            },
            "tolerance": {"$ref": "#/$defs/nonnegative"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target", "parameters", "tolerance"],
          "properties": {
            "kind": {"const": "child_count"},
            "target": {"$ref": "#/$defs/id"},
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value"],
              "properties": {"value": {"type": "integer", "minimum": 0}}
            },
            "tolerance": {"$ref": "#/$defs/nonnegative"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target", "parameters", "tolerance"],
          "properties": {
            "kind": {"const": "bounds"},
            "target": {"$ref": "#/$defs/id"},
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["min", "max"],
              "properties": {"min": {"$ref": "#/$defs/vector3"}, "max": {"$ref": "#/$defs/vector3"}}
            },
            "tolerance": {"$ref": "#/$defs/nonnegative"}
          }
        }
      ]
    }
  }
}
